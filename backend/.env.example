# ==========================================
# Django Production Environment Variables
# COPY THIS FILE TO .env AND FILL IN VALUES
# ==========================================

# Security Settings
# Generate a new secret key for production (e.g., using openssl rand -hex 32)
SECRET_KEY=change-this-to-a-very-long-secure-random-string
DEBUG=False

# Domain Settings (Comma separated, no spaces)
ALLOWED_HOSTS=api.dr-rahimi-pt.ir,dr-rahimi-pt.ir,www.dr-rahimi-pt.ir,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://dr-rahimi-pt.ir,https://www.dr-rahimi-pt.ir
CSRF_TRUSTED_ORIGINS=https://dr-rahimi-pt.ir,https://www.dr-rahimi-pt.ir,https://api.dr-rahimi-pt.ir
FRONTEND_URL=https://dr-rahimi-pt.ir

# Other Settings
TIME_ZONE=Asia/Tehran

# Zarinpal Payment Gateway
ZARINPAL_SANDBOX=False
ZARINPAL_MERCHANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
