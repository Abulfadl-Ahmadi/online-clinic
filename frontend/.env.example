# ==========================================
# Next.js Production Environment Variables
# COPY THIS FILE TO .env.local AND FILL VALUES
# ==========================================

NODE_ENV=production

# The absolute URL pointing to your backend API
BASE_API_URL=https://yourdomain.com/api/v1

# Timeout for API requests in milliseconds
API_TIMEOUT_MS=30000

# Local Storage key for registration state
NEXT_PUBLIC_REGISTER_STORE_KEY=online_clinic_register_state
